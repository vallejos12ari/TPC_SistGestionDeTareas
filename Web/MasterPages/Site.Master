<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="Web.MasterPages.Site" %>

<!DOCTYPE html>
<html lang="es">
<head runat="server">
    <title>Gestión de Tareas</title>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        body, * {
            font-family: 'Poppins', sans-serif !important;
        }
        
        .card-scroll {
            max-height: calc(100vh - 100px);
            overflow-y: auto;
            overflow-x: hidden;
        }

        .sidebar {
            width: 240px;
            min-width: 200px;
            height: calc(100vh - 56px);
        }
        
        .item-menu {
            text-decoration: none;
            color: inherit;
            font-weight: 600;
            font-size: 1.1rem;
            letter-spacing: 1px;
            display: block;
        }
        
        .item-menu:hover {
            background-color: #e5e5e5;
        }
        
        .item-submenu {
            text-decoration: none;
            color: inherit;
            font-weight: 400;
            font-size: 0.95rem;
            letter-spacing: 0.5px;
            padding: 4px 0;
        }
        
        .item-submenu:hover {
            background-color: #f0f0f0;
        }
        
        .fondo-oscuro {
            background-color: #e0e0e0;
            height: 95vh;
        }
    </style>

    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
</head>

<body>

    <form id="formularioMaster" runat="server">

        <nav class="navbar navbar-dark bg-dark px-4 d-flex justify-content-between">
            <a class="navbar-brand fw-bold" href="/Default.aspx">Gestión de Tareas</a>

            <div class="d-flex align-items-center gap-3">
                <asp:Label ID="TextoUsuario" runat="server" CssClass="text-white fw-light"></asp:Label>

                <asp:Button ID="BotonLogout" runat="server"
                            Text="Cerrar sesión"
                            CssClass="btn btn-danger btn-sm"
                            OnClick="ClickBotonLogout" />
            </div>
        </nav>

        <div class="d-flex">

            <asp:Panel ID="PanelSidebar" runat="server" CssClass="sidebar bg-light border-end p-3">
           
               <a href="/Pages/Usuarios/Listar" class="item-menu mt-3">Usuarios</a>
           
               <a class="item-menu mt-3" href="/Pages/Tareas/Listar">
                   Tareas
               </a>
           
               <div class="collapse show" id="submenuTareas">
                   <a href="/Pages/Estados/Listar" class="item-submenu d-block mt-2 ms-3">Estados</a>
                   <a href="/Pages/Prioridades/Listar" class="item-submenu d-block mt-2 ms-3">Prioridades</a>
                   <a href="/Pages/Tags/Listar" class="item-submenu d-block mt-2 ms-3">Tags</a>
                   <a href="/Pages/Relaciones/Listar" class="item-submenu d-block mt-2 ms-3">Relaciones</a>
               </div>
           </asp:Panel>
            
          <div class="flex-grow-1 d-flex fondo-oscuro p-4 min-vh-90">
              <div class="bg-white rounded-3 shadow-sm p-4 w-100 card-scroll">
                  <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
              </div>
          </div>
     </div>
    </form>
</body>
</html>
